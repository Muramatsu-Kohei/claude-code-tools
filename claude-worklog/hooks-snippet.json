{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/claude/ClaudeCode/claude-worklog/worklog.js session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/claude/ClaudeCode/claude-worklog/worklog.js session-end",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
